Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /SVG Mission Markers1
        - /Drone Body Axes1
        - /TF1
        - /Origin Axes1
      Splitter Ratio: 0.5
    Tree Height: 820
  - Class: rviz/Views
    Collapsed: false
    Name: Views
    Active:
      Class: rviz/Orbit
      Distance: 90
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Yaw: 0.785
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 5
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /svg_mission/markers
      Name: "SVG Mission Markers"
      Queue Size: 100
      Value: true
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 2
      Name: "Drone Body Axes"
      Radius: 0.08
      Reference Frame: drone
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 2
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 2
      Name: "Origin Axes"
      Radius: 0.08
      Reference Frame: map
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive: false
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Saved:
      - Class: rviz/Orbit
        Distance: 90
        Focal Point:
          X: 15
          Y: 15
          Z: 25
        Name: "Default 3/4 View"
        Pitch: 0.75
        Target Frame: <Fixed Frame>
        Yaw: 0.785
Window Geometry:
  Displays:
    collapsed: false
  Height: 960
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 0
  Y: 0
